<%- include('header', { title: 'Админ-панель — Учусь.РФ', user: locals.user }) %>
<div class="admin-page">
    <div class="admin-header">
        <h1>Панель управления</h1>
        <p>Управление заявками пользователей</p>
    </div>

    <!-- Фильтры -->
    <div class="admin-filters">
        <div class="filter-group">
            <label for="filterStatus">Статус:</label>
            <select id="filterStatus" onchange="applyFilters()">
                <option value="all">Все статусы</option>
                <option value="Новая">Новая</option>
                <option value="Идет обучение">Идет обучение</option>
                <option value="Обучение завершено">Обучение завершено</option>
            </select>
        </div>
        <div class="filter-group">
            <label for="filterCourse">Курс:</label>
            <select id="filterCourse" onchange="applyFilters()">
                <option value="all">Все курсы</option>
                <% if (courses && courses.length > 0) { %>
                    <% courses.forEach(function(course) { %>
                        <option value="<%= course.id %>"><%= course.title %></option>
                    <% }); %>
                <% } %>
            </select>
        </div>
        <div class="filter-group">
            <label for="filterSearch">Поиск:</label>
            <input type="text" id="filterSearch" placeholder="Поиск по ФИО или логину..." oninput="applyFilters()">
        </div>
    </div>

    <!-- Статистика -->
    <div class="admin-stats">
        <div class="stat-card">
            <span class="stat-number"><%= allApplications ? allApplications.length : 0 %></span>
            <span class="stat-label">Всего заявок</span>
        </div>
        <div class="stat-card stat-new">
            <span class="stat-number"><%= allApplications ? allApplications.filter(a => a.status === 'Новая').length : 0 %></span>
            <span class="stat-label">Новые</span>
        </div>
        <div class="stat-card stat-progress">
            <span class="stat-number"><%= allApplications ? allApplications.filter(a => a.status === 'Идет обучение').length : 0 %></span>
            <span class="stat-label">В обучении</span>
        </div>
        <div class="stat-card stat-done">
            <span class="stat-number"><%= allApplications ? allApplications.filter(a => a.status === 'Обучение завершено').length : 0 %></span>
            <span class="stat-label">Завершено</span>
        </div>
    </div>

    <!-- Таблица заявок -->
    <div class="table-wrapper">
        <table class="admin-table" id="applicationsTable">
            <thead>
                <tr>
                    <th onclick="sortTable(0)">ID</th>
                    <th onclick="sortTable(1)">Пользователь</th>
                    <th onclick="sortTable(2)">Курс</th>
                    <th onclick="sortTable(3)">Дата старта</th>
                    <th onclick="sortTable(4)">Оплата</th>
                    <th onclick="sortTable(5)">Статус</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody id="tableBody">
                <% if (allApplications && allApplications.length > 0) { %>
                    <% allApplications.forEach(function(app) { %>
                        <tr data-status="<%= app.status %>" data-course="<%= app.course_id %>" data-user="<%= (app.user_name + ' ' + app.user_login).toLowerCase() %>">
                            <td><%= app.id %></td>
                            <td><%= app.user_name %><br><small><%= app.user_login %></small></td>
                            <td><%= app.course_title %></td>
                            <td><%= new Date(app.start_date).toLocaleDateString('ru-RU') %></td>
                            <td><%= app.payment_method %></td>
                            <td><span class="status-badge status-<%= app.status === 'Новая' ? 'new' : app.status === 'Идет обучение' ? 'in-progress' : 'completed' %>"><%= app.status %></span></td>
                            <td>
                                <select class="status-select" data-appid="<%= app.id %>" onchange="changeStatus(this)">
                                    <option value="Новая" <%= app.status === 'Новая' ? 'selected' : '' %>>Новая</option>
                                    <option value="Идет обучение" <%= app.status === 'Идет обучение' ? 'selected' : '' %>>Идет обучение</option>
                                    <option value="Обучение завершено" <%= app.status === 'Обучение завершено' ? 'selected' : '' %>>Обучение завершено</option>
                                </select>
                            </td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr><td colspan="7" class="empty-cell">Заявок пока нет</td></tr>
                <% } %>
            </tbody>
        </table>
    </div>

    <!-- Пагинация -->
    <div class="pagination" id="pagination"></div>
</div>

<!-- Модальное окно уведомления -->
<div id="notifyModal" class="modal">
    <div class="modal-content modal-small">
        <span class="modal-close">&times;</span>
        <div class="modal-icon">✅</div>
        <h2 id="notifyTitle">Статус обновлён</h2>
        <p id="notifyMessage">Статус заявки успешно изменён</p>
        <button class="btn btn-primary btn-full modal-close-btn">ОК</button>
    </div>
</div>

<script>
let currentPage = 1;
const perPage = 10;

function applyFilters() {
    const status = document.getElementById('filterStatus').value;
    const course = document.getElementById('filterCourse').value;
    const search = document.getElementById('filterSearch').value.toLowerCase();
    const rows = document.querySelectorAll('#tableBody tr');
    
    let visibleCount = 0;
    rows.forEach(row => {
        if (row.cells.length < 7) return;
        const rowStatus = row.getAttribute('data-status');
        const rowCourse = row.getAttribute('data-course');
        const rowUser = row.getAttribute('data-user');
        
        const matchStatus = status === 'all' || rowStatus === status;
        const matchCourse = course === 'all' || rowCourse === course;
        const matchSearch = !search || rowUser.includes(search);
        
        if (matchStatus && matchCourse && matchSearch) {
            visibleCount++;
            row.style.display = '';
        } else {
            row.style.display = 'none';
        }
    });
    
    setupPagination();
}

function setupPagination() {
    const rows = document.querySelectorAll('#tableBody tr:not([style*="display: none"])');
    const totalPages = Math.ceil(rows.length / perPage);
    const pagination = document.getElementById('pagination');
    
    if (totalPages <= 1) {
        pagination.innerHTML = '';
        return;
    }
    
    let html = '';
    for (let i = 1; i <= totalPages; i++) {
        html += `<button class="page-btn ${i === currentPage ? 'active' : ''}" onclick="goToPage(${i})">${i}</button>`;
    }
    pagination.innerHTML = html;
    
    // Show only current page rows
    rows.forEach((row, index) => {
        row.style.display = (index >= (currentPage - 1) * perPage && index < currentPage * perPage) ? '' : 'none';
    });
}

function goToPage(page) {
    currentPage = page;
    setupPagination();
}

function sortTable(colIndex) {
    const table = document.getElementById('applicationsTable');
    const tbody = table.querySelector('tbody');
    const rows = Array.from(tbody.querySelectorAll('tr'));
    
    if (rows.length === 0 || rows[0].cells.length < 7) return;
    
    const sorted = rows.sort((a, b) => {
        let aVal = a.cells[colIndex]?.textContent.trim() || '';
        let bVal = b.cells[colIndex]?.textContent.trim() || '';
        return aVal.localeCompare(bVal, 'ru');
    });
    
    sorted.forEach(row => tbody.appendChild(row));
    setupPagination();
}

function changeStatus(select) {
    const appId = select.getAttribute('data-appid');
    const newStatus = select.value;
    
    fetch('/admin/update-status', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: appId, status: newStatus })
    })
    .then(res => res.json())
    .then(data => {
        if (data.success) {
            document.getElementById('notifyTitle').textContent = 'Статус обновлён';
            document.getElementById('notifyMessage').textContent = `Заявка #${appId} теперь имеет статус «${newStatus}»`;
            document.getElementById('notifyModal').style.display = 'flex';
            // Update badge in the row
            const badge = select.closest('tr').querySelector('.status-badge');
            if (badge) {
                badge.textContent = newStatus;
                badge.className = 'status-badge status-' + (newStatus === 'Новая' ? 'new' : newStatus === 'Идет обучение' ? 'in-progress' : 'completed');
            }
        }
    });
}

// Modal close handlers
document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.modal-close, .modal-close-btn').forEach(el => {
        el.addEventListener('click', function() {
            this.closest('.modal').style.display = 'none';
        });
    });
    
    setupPagination();
});
</script>
<%- include('footer') %>