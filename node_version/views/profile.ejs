<%- include('header', { title: 'Личный кабинет — Учусь.РФ', user: locals.user }) %>
<div class="profile-page">
    <div class="profile-header">
        <div class="profile-avatar">
            <span><%= user.fullname.charAt(0).toUpperCase() %></span>
        </div>
        <div class="profile-info">
            <h1><%= user.fullname %></h1>
            <p class="profile-detail"><span class="icon">📧</span> <%= user.email %></p>
            <p class="profile-detail"><span class="icon">📞</span> <%= user.phone %></p>
        </div>
    </div>

    <!-- Слайдер -->
    <div class="slider-container">
        <div class="slider">
            <div class="slide active">
                <img src="/images/slide1.jpg" alt="Обучение 1" onerror="this.src='data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%22390%22 height=%22200%22><rect fill=%22%234a90e2%22 width=%22390%22 height=%22200%22/><text x=%22195%22 y=%22100%22 text-anchor=%22middle%22 fill=%22white%22 font-size=%2220%22>Курсы повышения квалификации</text></svg>'">
            </div>
            <div class="slide">
                <img src="/images/slide2.jpg" alt="Обучение 2" onerror="this.src='data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%22390%22 height=%22200%22><rect fill=%22%235c6bc0%22 width=%22390%22 height=%22200%22/><text x=%22195%22 y=%22100%22 text-anchor=%22middle%22 fill=%22white%22 font-size=%2220%22>Курсы переподготовки</text></svg>'">
            </div>
            <div class="slide">
                <img src="/images/slide3.jpg" alt="Обучение 3" onerror="this.src='data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%22390%22 height=%22200%22><rect fill=%22%2326a69a%22 width=%22390%22 height=%22200%22/><text x=%22195%22 y=%22100%22 text-anchor=%22middle%22 fill=%22white%22 font-size=%2220%22>Курсы по охране труда</text></svg>'">
            </div>
            <div class="slide">
                <img src="/images/slide4.jpg" alt="Обучение 4" onerror="this.src='data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%22390%22 height=%22200%22><rect fill=%22%23e74c3c%22 width=%22390%22 height=%22200%22/><text x=%22195%22 y=%22100%22 text-anchor=%22middle%22 fill=%22white%22 font-size=%2220%22>Дистанционное обучение</text></svg>'">
            </div>
        </div>
        <button class="slider-btn slider-prev" onclick="changeSlide(-1)">&#10094;</button>
        <button class="slider-btn slider-next" onclick="changeSlide(1)">&#10095;</button>
        <div class="slider-dots"></div>
    </div>

    <!-- Мои заявки -->
    <section class="section">
        <h2>Мои заявки</h2>
        <% if (applications && applications.length > 0) { %>
            <div class="applications-list">
                <% applications.forEach(function(app) { %>
                    <div class="application-card status-<%= app.status === 'Новая' ? 'new' : app.status === 'Идет обучение' ? 'in-progress' : 'completed' %>">
                        <div class="app-header">
                            <h3><%= app.course_title %></h3>
                            <span class="status-badge"><%= app.status %></span>
                        </div>
                        <div class="app-details">
                            <p><span class="label">Дата старта:</span> <%= new Date(app.start_date).toLocaleDateString('ru-RU') %></p>
                            <p><span class="label">Способ оплаты:</span> <%= app.payment_method %></p>
                            <p><span class="label">Дата заявки:</span> <%= new Date(app.created_at).toLocaleString('ru-RU') %></p>
                        </div>
                        <% if (app.status === 'Обучение завершено') { %>
                            <button class="btn btn-secondary btn-sm open-review" data-appid="<%= app.id %>">Оставить отзыв</button>
                        <% } %>
                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <div class="empty-state">
                <p>У вас пока нет заявок</p>
                <a href="/apply" class="btn btn-primary">Записаться на курс</a>
            </div>
        <% } %>
    </section>

    <!-- Отзывы пользователя -->
    <section class="section">
        <h2>Мои отзывы</h2>
        <% if (reviews && reviews.length > 0) { %>
            <div class="reviews-list">
                <% reviews.forEach(function(rev) { %>
                    <div class="review-card">
                        <div class="review-header">
                            <span class="review-course"><%= rev.course_title %></span>
                            <span class="review-date"><%= new Date(rev.created_at).toLocaleDateString('ru-RU') %></span>
                        </div>
                        <div class="review-rating">
                            <% for (let i = 0; i < 5; i++) { %>
                                <span class="star <%= i < rev.rating ? 'filled' : '' %>">★</span>
                            <% } %>
                        </div>
                        <p class="review-text"><%= rev.comment %></p>
                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <p class="empty-text">Вы ещё не оставляли отзывов</p>
        <% } %>
    </section>
</div>

<!-- Модальное окно для отзыва -->
<div id="reviewModal" class="modal">
    <div class="modal-content">
        <span class="modal-close">&times;</span>
        <h2>Оставить отзыв</h2>
        <form action="/review" method="POST" id="reviewForm">
            <input type="hidden" name="application_id" id="reviewAppId">
            <div class="form-group">
                <label>Оценка</label>
                <div class="rating-select">
                    <input type="radio" name="rating" value="1" id="star1"><label for="star1">★</label>
                    <input type="radio" name="rating" value="2" id="star2"><label for="star2">★</label>
                    <input type="radio" name="rating" value="3" id="star3"><label for="star3">★</label>
                    <input type="radio" name="rating" value="4" id="star4"><label for="star4">★</label>
                    <input type="radio" name="rating" value="5" id="star5"><label for="star5">★</label>
                </div>
            </div>
            <div class="form-group">
                <label for="comment">Комментарий</label>
                <textarea name="comment" id="comment" rows="3" placeholder="Поделитесь впечатлениями о курсе..."></textarea>
            </div>
            <button type="submit" class="btn btn-primary btn-full">Отправить отзыв</button>
        </form>
    </div>
</div>
<%- include('footer') %>