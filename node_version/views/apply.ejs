<%- include('header', { title: 'Запись на курс — Учусь.РФ', user: locals.user }) %>
<div class="apply-page">
    <div class="apply-card">
        <div class="auth-header">
            <h1>Запись на курс</h1>
            <p>Выберите программу обучения</p>
        </div>
        <form action="/apply" method="POST" class="auth-form" id="applyForm" novalidate>
            <div class="form-group">
                <label for="course_id">Выберите курс</label>
                <select id="course_id" name="course_id" required>
                    <option value="">-- Выберите курс --</option>
                    <% if (courses && courses.length > 0) { %>
                        <% courses.forEach(function(course) { %>
                            <option value="<%= course.id %>"><%= course.title %> (<%= course.type %>) — <%= course.price %> руб.</option>
                        <% }); %>
                    <% } %>
                </select>
                <span class="form-error" id="courseError"></span>
            </div>
            <div class="form-group">
                <label for="start_date">Предпочтительная дата начала</label>
                <input type="date" id="start_date" name="start_date" required>
                <span class="form-error" id="dateError"></span>
            </div>
            <div class="form-group">
                <label for="payment_method">Способ оплаты</label>
                <select id="payment_method" name="payment_method" required>
                    <option value="">-- Выберите способ оплаты --</option>
                    <option value="Банковская карта">Банковская карта</option>
                    <option value="Банковский перевод">Банковский перевод</option>
                    <option value="Электронные деньги">Электронные деньги</option>
                    <option value="Наличные">Наличные</option>
                </select>
                <span class="form-error" id="paymentError"></span>
            </div>
            <% if (locals.error) { %>
                <div class="form-alert form-alert-error"><%= error %></div>
            <% } %>
            <% if (locals.success) { %>
                <div class="form-alert form-alert-success"><%= success %></div>
            <% } %>
            <button type="submit" class="btn btn-primary btn-full">Отправить заявку</button>
        </form>
    </div>
</div>
<%- include('footer') %>