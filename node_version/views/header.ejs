<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'Учусь.РФ' %></title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🎓</text></svg>">
    <script src="/js/app.js" defer></script>
</head>
<body>
    <div class="app-container">
        <nav class="top-nav">
            <div class="nav-brand">
                <a href="/">Учусь.РФ</a>
            </div>
            <div class="nav-links">
                <% if (locals.user) { %>
                    <a href="/profile" class="nav-link">Личный кабинет</a>
                    <a href="/apply" class="nav-link">Запись на курс</a>
                    <% if (user.role === 'admin') { %>
                        <a href="/admin" class="nav-link">Админ-панель</a>
                    <% } %>
                    <a href="/logout" class="nav-link btn-logout">Выйти</a>
                <% } else { %>
                    <a href="/login" class="nav-link">Войти</a>
                    <a href="/register" class="nav-link btn-register">Регистрация</a>
                <% } %>
            </div>
        </nav>
        <main class="main-content">